{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Education Policy Record",
  "type": "object",
  "required": [
    "id",
    "agency",
    "issuance_type",
    "title",
    "issued_at",
    "effective_from",
    "effective_until",
    "status",
    "topics",
    "scope",
    "relations",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "agency": {
      "type": "string",
      "minLength": 1
    },
    "issuance_type": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "series_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "scope": {"type": ["string", "null"]},
          "verified": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": [
        "official",
        "url"
      ],
      "properties": {
        "official": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
