{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Competency Assessment",
  "type": "object",
  "required": [
    "subject",
    "period",
    "competencies"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "level",
          "evidence"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_level_evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
