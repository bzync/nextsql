[Unit]
Description=NextSQL database server
Documentation=https://github.com/bzync/nextsql
After=network-online.target
Wants=network-online.target
# Do not start until the operator has initialized a data directory.
ConditionPathExists=/etc/nextsql/nextsql.conf
ConditionPathExists=/var/lib/nextsql/nextsql.db

[Service]
Type=simple
User=nextsql
Group=nextsql
ExecStart=/usr/bin/nextsqld --config /etc/nextsql/nextsql.conf
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nextsql /var/lib/nextsql-wal
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
